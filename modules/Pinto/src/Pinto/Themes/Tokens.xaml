<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Windows 字体与 DIP；字号由 ThemeService 按系统文字缩放更新。 -->
    <FontFamily x:Key="AppFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <sys:Double x:Key="DisplayFontSize">20</sys:Double>
    <sys:Double x:Key="TitleFontSize">17</sys:Double>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="UtilityFontSize">13</sys:Double>
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <CornerRadius x:Key="WindowRadius">14</CornerRadius>
    <CornerRadius x:Key="InputRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>
    <Thickness x:Key="WindowInset">16,0,16,16</Thickness>
    <Thickness x:Key="RowPadding">4</Thickness>
    <Thickness x:Key="DialogInset">24</Thickness>
    <Thickness x:Key="ButtonPadding">16,8</Thickness>
    <sys:Double x:Key="ControlSize">28</sys:Double>
    <sys:Double x:Key="RowMinHeight">36</sys:Double>
</ResourceDictionary>
