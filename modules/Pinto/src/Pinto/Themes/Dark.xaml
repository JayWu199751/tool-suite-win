<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 暗 token：取值见 docs/UI Design/Apple Dark.md（落地映射见 docs/design-system.md）。
         便签窗口本身用 #0C0C0E：它直接压在桌面上，比卡片再暗一档才与壁纸分开；
         浮在便签之上的菜单/提示仍用 #141419，两者靠 1 DIP 发丝描边分层。
         次要文字取 #A0A0AC：在 Surface / Hover / Input 三种底色上均 ≥ 4.5:1。 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0C0C0E" />
    <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#141419" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F5" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#A0A0AC" />
    <SolidColorBrush x:Key="CompletedBrush" Color="#A0A0AC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ActiveBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="InputBrush" Color="#15151A" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="CircleBrush" Color="#7E7E8A" />
    <SolidColorBrush x:Key="FocusBrush" Color="#7B77E0" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#597B77E0" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#55555F" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="CloseForegroundBrush" Color="#F2F2F5" />
</ResourceDictionary>
