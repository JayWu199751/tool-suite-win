<Window x:Class="Pinto.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入备份" Width="480" MaxHeight="{x:Static SystemParameters.PrimaryScreenHeight}" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SolidSurfaceBrush}" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" KeyboardNavigation.TabNavigation="Cycle">
    <!-- 使用 Windows 标准窗口框架；滚动正文与固定取消按钮适应大字号。
         选项卡：20 DIP 圆角、发丝描边、零投影；主选项用单一蓝色描边与标题色标记。 -->
    <Window.Resources>
        <Style x:Key="OptionCard" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource ActiveBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryOptionCard" TargetType="Button" BasedOn="{StaticResource OptionCard}">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
        </Style>
        <!-- 幽灵胶囊：次要操作只用描边与文字，不填底色（参考稿的中等强调按钮）。 -->
        <Style x:Key="GhostPillButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillRoot" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PillRoot" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="{DynamicResource DialogInset}">
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="导入便签备份" FontSize="{DynamicResource DisplayFontSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Summary" Foreground="{DynamicResource SecondaryBrush}" Margin="0,8,0,24" TextWrapping="Wrap" />
                <Button x:Name="AppendButton" Style="{StaticResource PrimaryOptionCard}" Click="Append_Click" HorizontalContentAlignment="Left" IsDefault="True" AutomationProperties.Name="追加导入" AutomationProperties.HelpText="保留当前便签，将备份作为独立副本加入">
                    <StackPanel><TextBlock Text="追加导入" FontWeight="SemiBold" /><TextBlock Text="保留当前便签，将备份作为独立副本加入。" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource SecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                </Button>
                <Button x:Name="ReplaceButton" Style="{StaticResource OptionCard}" Click="Replace_Click" HorizontalContentAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="替换全部" AutomationProperties.HelpText="替换当前所有便签，执行前确认并自动保留备份">
                    <StackPanel><TextBlock Text="替换全部…" FontWeight="SemiBold" /><TextBlock Text="替换当前所有便签，执行前自动保留备份。" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource SecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                </Button>
                <TextBlock Text="两种方式均保留当前主题与开机启动设置。" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource SecondaryBrush}" Margin="0,18,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" Content="取消" Style="{StaticResource GhostPillButton}" IsCancel="True" HorizontalAlignment="Right" MinWidth="88" MinHeight="36" Margin="0,24,0,0" />
    </Grid>
</Window>
