<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 暗 token：取值见 docs/design-system.md（Apple Dark 落地映射）。
         纯黑画布 + 炭黑卡片，层级只靠色差与圆角，不用投影。 -->

    <SolidColorBrush x:Key="Brush.App" Color="#000000" />
    <SolidColorBrush x:Key="Brush.Card" Color="#1D1D1F" />
    <SolidColorBrush x:Key="Brush.Input" Color="#000000" />
    <SolidColorBrush x:Key="Brush.Bg.Active" Color="#2A2A2C" />

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#333336" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#4A4A4E" />
    <SolidColorBrush x:Key="Brush.Border.Selected" Color="#2997FF" />
    <SolidColorBrush x:Key="Brush.Selection.Background" Color="#1F2997FF" />

    <SolidColorBrush x:Key="Brush.Window.Ring" Color="#333336" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#86868B" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#A1A1A6" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#55555C" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#0071E3" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="#2997FF" />

    <SolidColorBrush x:Key="Brush.Success" Color="#30D158" />
    <SolidColorBrush x:Key="Brush.Error" Color="#FF453A" />

    <SolidColorBrush x:Key="Brush.Ring.Soft" Color="#330071E3" />

    <!-- 图卡棋盘格：中性色差表达透明区域，不再使用彩色渐变底 -->
    <SolidColorBrush x:Key="Brush.Thumb.Checker" Color="#08FFFFFF" />

</ResourceDictionary>
