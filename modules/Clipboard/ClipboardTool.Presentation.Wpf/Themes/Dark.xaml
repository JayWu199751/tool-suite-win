<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 暗 token：取值见 docs/UI Design/Apple Dark.md（落地映射见 docs/design-system.md）。
         近黑画布 + 炭黑卡片，层级只靠色差与圆角，不用投影；
         描边/悬停/选中沿用参考稿的 alpha 口径（6% / 9% / 12% 白，13% 靛蓝淡染 + 45% 靛蓝描边）。 -->

    <SolidColorBrush x:Key="Brush.App" Color="#0B0B0E" />
    <SolidColorBrush x:Key="Brush.Card" Color="#141419" />
    <SolidColorBrush x:Key="Brush.Input" Color="#15151A" />
    <SolidColorBrush x:Key="Brush.Bg.Active" Color="#17FFFFFF" />

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Border.Selected" Color="#737B77E0" />
    <SolidColorBrush x:Key="Brush.Selection.Background" Color="#217B77E0" />

    <SolidColorBrush x:Key="Brush.Window.Ring" Color="#757575" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F2F2F5" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A0A0AC" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#7E7E8A" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#55555F" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#7B77E0" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="#A7A4F0" />

    <SolidColorBrush x:Key="Brush.Success" Color="#57C08A" />
    <SolidColorBrush x:Key="Brush.Error" Color="#E05A52" />

    <SolidColorBrush x:Key="Brush.Ring.Soft" Color="#1F7B77E0" />

    <!-- 图卡棋盘格：中性色差表达透明区域，不再使用彩色渐变底 -->
    <SolidColorBrush x:Key="Brush.Thumb.Checker" Color="#08FFFFFF" />

</ResourceDictionary>
