<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 高对比度 token：键集合与 Light.xaml/Dark.xaml 完全一致（缺键即运行期异常），
         取值全部来自系统高对比度配色，不引入第二套视觉设计。 -->

    <SolidColorBrush x:Key="Brush.App" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Input" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.Bg.Active" Color="{x:Static SystemColors.HighlightColor}" />

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{x:Static SystemColors.ControlDarkDarkColor}" />
    <SolidColorBrush x:Key="Brush.Border.Selected" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.Selection.Background" Color="{x:Static SystemColors.HighlightColor}" />

    <SolidColorBrush x:Key="Brush.Window.Ring" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{x:Static SystemColors.GrayTextColor}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="{x:Static SystemColors.HighlightTextColor}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="Brush.Ring.Soft" Color="{x:Static SystemColors.HighlightColor}" />

    <SolidColorBrush x:Key="Brush.Thumb.Checker" Color="{x:Static SystemColors.ControlColor}" />

</ResourceDictionary>
