<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 亮 token：取值见 docs/design-system.md（Apple Light 落地映射）。
         键名是面板与托盘菜单的契约，三套主题必须完全一致。 -->

    <SolidColorBrush x:Key="Brush.App" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Input" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Brush.Bg.Active" Color="#E8E8ED" />

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#D6D6D6" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#B8B8BD" />
    <SolidColorBrush x:Key="Brush.Border.Selected" Color="#0071E3" />
    <SolidColorBrush x:Key="Brush.Selection.Background" Color="#0F0071E3" />

    <SolidColorBrush x:Key="Brush.Window.Ring" Color="#D6D6D6" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1D1D1F" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#63636A" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#75757A" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#A1A1A6" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#0071E3" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="#0066CC" />

    <SolidColorBrush x:Key="Brush.Success" Color="#1D8348" />
    <SolidColorBrush x:Key="Brush.Error" Color="#C7261F" />

    <SolidColorBrush x:Key="Brush.Ring.Soft" Color="#290071E3" />

    <!-- 图卡棋盘格：中性色差表达透明区域，不再使用彩色渐变底 -->
    <SolidColorBrush x:Key="Brush.Thumb.Checker" Color="#06000000" />

</ResourceDictionary>
