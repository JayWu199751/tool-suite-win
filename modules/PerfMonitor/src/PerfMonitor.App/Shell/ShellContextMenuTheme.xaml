<ResourceDictionary x:Class="PerfMonitor.App.Shell.ShellContextMenuTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 托盘/性能条共享菜单的皮肤：取值见 docs/design-system.md。
         圆角 16 容器 + 圆角 10 行、1 DIP 发丝描边、零投影、单一蓝色勾选。
         默认画刷为暗色值，运行时由 ShellContextMenuTheme.Apply(dark) 逐键覆盖，
         DynamicResource 引用即时跟随。 -->
    <SolidColorBrush x:Key="ShellMenuBackgroundBrush" Color="#FF1D1D1F" />
    <SolidColorBrush x:Key="ShellMenuForegroundBrush" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="ShellMenuSecondaryBrush" Color="#FF86868B" />
    <SolidColorBrush x:Key="ShellMenuCheckBrush" Color="#FF0071E3" />
    <SolidColorBrush x:Key="ShellMenuHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ShellMenuBorderBrush" Color="#FF333336" />
    <SolidColorBrush x:Key="ShellMenuDividerBrush" Color="#FF2A2A2C" />

    <Style x:Key="ShellMenuRootStyle" TargetType="{x:Type ContextMenu}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ShellMenuForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{DynamicResource ShellMenuBackgroundBrush}"
                            BorderBrush="{DynamicResource ShellMenuBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="6"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Foreground" Value="{DynamicResource ShellMenuForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="ItemRoot"
                            Background="Transparent"
                            CornerRadius="10"
                            Padding="8,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="CheckMark"
                                  Data="M1,4.5 L4,7.5 L9,1.5"
                                  Width="10" Height="9"
                                  Stretch="None"
                                  Stroke="{DynamicResource ShellMenuCheckBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ShellMenuHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellMenuSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Margin="10,6" Background="{DynamicResource ShellMenuDividerBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
